LLM_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus
AUDIO_FISH_API_KEY=your_audio_fish_api_key
BACKOFF_MAX_TRIES=5
BACKOFF_MAX_TIME=300
MAX_RETRY=3

# Picture overlay configuration (using ratio mode for different video resolutions)
# All ratio values are between 0.0 and 1.0 (e.g., 0.15 = 15% of video dimension)
# Picture height is automatically calculated to maintain original aspect ratio
# PICTURE_X_RATIO can be negative to move picture left (partially off-screen)
PICTURE_WIDTH_RATIO=0.15
PICTURE_X_RATIO=0.02
PICTURE_Y_RATIO=-1
PICTURE_BOTTOM_MARGIN_RATIO=0.02

FONT_PATH=assets/microhei.ttc


# token you need to set
SILICONFLOW_API_TOKEN=your_silicon_flow_api_token
PROJECT_NAME=project_name_for_debug




